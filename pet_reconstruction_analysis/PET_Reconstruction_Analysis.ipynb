    "## 4. Симуляция реконструкции\n",
    "\n",
    "### Важное замечание об аппроксимации\n",
    "\n",
    "**Полная OSEM-реконструкция требует raw sinogram-данных**, которые обычно недоступны из клинических DICOM.\n",
    "\n",
    "Для целей данной курсовой работы реализована **научно обоснованная аппроксимация**:\n",
    "\n",
    "1. **Модель сходимости** основана на эмпирических данных [Laforest et al., JNM 2016]:\n",
    "   ```\n",
    "   RC(iter) = RC_max × (1 - exp(-k × iter × subsets / 21))\n",
    "   ```\n",
    "\n",
    "2. **Модель шума** учитывает рост шума с итерациями:\n",
    "   ```\n",
    "   Noise(iter) = Noise₀ × √(1 + β × iter)\n",
    "   ```\n",
    "\n",
    "3. **Пост-фильтрация** зависит от числа подмножеств (больше подмножеств = больше высокочастотного шума)\n",
    "\n",
    "Это допустимо для курсовой работы, так как:\n",
    "- Воспроизводит основные тенденции реальных данных\n",
    "- Позволяет изучить относительное влияние параметров\n",
    "- Соответствует литературным данным"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Инициализация симулятора\n",
    "recon_config = ReconstructionConfig(\n",
    "    iterations=4,\n",
    "    subsets=21,\n",
    "    matrix_size=192,\n",
    "    filter_fwhm_mm=5.0,\n",
    ")\n",
    "\n",
    "simulator = ReconstructionSimulator(recon_config)\n",
    "simulator.set_spacing((4.0, 4.0, 3.0))  # Типичное разрешение ПЭТ\n",
    "\n",
    "# Создание сетки параметров\n",
    "param_grid = simulator.create_parameter_grid()\n",
    "print(f\"Создана сетка параметров: {len(param_grid)} комбинаций\")\n",
    "print(f\"Пример: {param_grid[0]}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Обработка всех комбинаций\n",
    "from tqdm import tqdm\n",
    "\n",
    "print(\"Выполнение реконструкций...\")\n",
    "results = {}\n",
    "\n",
    "for i, params in enumerate(tqdm(param_grid, desc=\"Reconstruction\")):\n",
    "    key = f\"iter{params['iterations']}_sub{params['subsets']}_mat{params['matrix_size']}\"\n",
    "    \n",
    "    reconstructed = simulator.simulate_reconstruction(\n",
    "        volume,\n",
    "        iterations=params['iterations'],\n",
    "        subsets=params['subsets'],\n",
    "        matrix_size=params['matrix_size'],\n",
    "        seed=CONFIG['random_seed'] + i\n",
    "    )\n",
    "    \n",
    "    results[key] = {\n",
    "        'volume': reconstructed,\n",
    "        'params': params,\n",
    "    }\n",
    "\n",
    "print(f\"✓ Выполнено {len(results)} реконструкций\")\n",
    "\n",
    "# Сохранение промежуточных результатов\n",
    "import pickle\n",
    "with open(CONFIG['paths']['results_processed'] + '/reconstructions.pkl', 'wb') as f:\n",
    "    pickle.dump(results, f)\n",
    "print(f\"✓ Результаты сохранены в {CONFIG['paths']['results_processed']}/reconstructions.pkl\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Расчёт количественных метрик"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Инициализация калькулятора метрик\n",
    "calculator = MetricsCalculator(\n",
    "    sphere_diameters=CONFIG['phantom']['sphere_diameters'],\n",
    "    true_sphere_suvs=true_sphere_suvs,\n",
    "    background_suv=CONFIG['phantom']['background_suv'],\n",
    ")\n",
    "\n",
    "# Массовый анализ всех реконструкций\n",
    "print(\"Анализ метрик для всех реконструкций...\")\n",
    "\n",
    "all_metrics = []\n",
    "background_metrics_list = []\n",
    "\n",
    "for key, data in tqdm(results.items(), desc=\"Analyzing\"):\n",
    "    vol = data['volume']\n",
    "    params = data['params']\n",
    "    \n",
    "    calc = MetricsCalculator(\n",
    "        sphere_diameters=CONFIG['phantom']['sphere_diameters'],\n",
    "        true_sphere_suvs=true_sphere_suvs,\n",
    "        background_suv=CONFIG['phantom']['background_suv'],\n",
    "    )\n",
    "    \n",
    "    calc.set_volume(vol, spacing=(4.0, 4.0, 3.0))\n",
    "    \n",
    "    # Использование готовых масок если доступны\n",
    "    if sphere_masks:\n",
    "        calc.load_sphere_masks(sphere_masks)\n",
    "    else:\n",
    "        calc.detect_spheres(threshold_factor=1.5)\n",
    "    \n",
    "    analysis = calc.full_analysis(params)\n",
    "    \n",
    "    spheres_df = analysis['spheres']\n",
    "    spheres_df['reconstruction_key'] = key\n",
    "    all_metrics.append(spheres_df)\n",
    "    \n",
    "    if analysis['background']:\n",
    "        bg_dict = analysis['background'].copy()\n",
    "        bg_dict['reconstruction_key'] = key\n",
    "        bg_dict.update(params)\n",
    "        background_metrics_list.append(bg_dict)\n",
    "\n",
    "# Объединение результатов\n",
    "metrics_df = pd.concat(all_metrics, ignore_index=True)\n",
    "bg_df = pd.DataFrame(background_metrics_list)\n",
    "\n",
    "print(f\"\\n✓ Проанализировано сфер: {len(metrics_df)}\")\n",
    "print(f\"✓ Метрики фона: {len(bg_df)} измерений\")\n",
    "print(f\"\\nКолонки метрик: {list(metrics_df.columns)}\")"
   ]
