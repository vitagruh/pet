    "    \n",
    "    noise_summary = bg_df.groupby(['iterations', 'subsets'])['noise_cv'].agg(['mean', 'std']).round(2)\n",
    "    display(noise_summary.unstack())\n",
    "    \n",
    "    # Корреляция между RC и шумом\n",
    "    merged = metrics_df.merge(\n",
    "        bg_df[['iterations', 'subsets', 'matrix_size', 'noise_cv']],\n",
    "        on=['iterations', 'subsets', 'matrix_size'],\n",
    "        how='inner'\n",
    "    )\n",
    "    \n",
    "    correlation = merged['rc_mean'].corr(merged['noise_cv'])\n",
    "    print(f\"\\nКорреляция RC ↔ Noise: {correlation:.3f}\")\n",
    "else:\n",
    "    print(\"Нет данных о шуме для анализа\")"
   ]
