    "    \n",
    "else:\n",
    "    print(\"Загрузка DICOM-данных...\")\n",
    "    \n",
    "    dicom_path = Path(CONFIG['paths']['dicom_input'])\n",
    "    \n",
    "    if not dicom_path.exists():\n",
    "        raise FileNotFoundError(f\"DICOM папка не найдена: {dicom_path}\")\n",
    "    \n",
    "    # Загрузка\n",
    "    pet_volume = load_pet_dicom(dicom_path, recursive=True)\n",
    "    volume = pet_volume.image_array\n",
    "    \n",
    "    # Метаданные\n",
    "    true_sphere_suvs = None  # Будет определено вручную\n",
    "    sphere_masks = None  # Потребуется ручная сегментация\n",
    "    \n",
    "    print(f\"✓ Загружен объём: {volume.shape}\")\n",
    "    print(f\"✓ Диапазон SUV: [{volume.min():.3f}, {volume.max():.3f}]\")\n",
    "    print(f\"✓ Вес пациента: {pet_volume.metadata.patient_weight} кг\")\n",
    "    print(f\"✓ Введённая доза: {pet_volume.metadata.injected_dose/1e6:.1f} МБк\")"
