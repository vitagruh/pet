  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Анализ влияния параметров на RC (ANOVA-like)\n",
    "print(\"=== Влияние параметров на Recovery Coefficient ===\\n\")\n",
    "\n",
    "# Группировка по итерациям\n",
    "rc_by_iter = metrics_df.groupby('iterations')['rc_mean'].agg(['mean', 'std', 'count']).round(3)\n",
    "print(\"По итерациям:\")\n",
    "display(rc_by_iter)\n",
    "\n",
    "# Группировка по подмножествам\n",
    "rc_by_sub = metrics_df.groupby('subsets')['rc_mean'].agg(['mean', 'std', 'count']).round(3)\n",
    "print(\"\\nПо подмножествам:\")\n",
    "display(rc_by_sub)\n",
    "\n",
    "# Группировка по матрице\n",
    "rc_by_mat = metrics_df.groupby('matrix_size')['rc_mean'].agg(['mean', 'std', 'count']).round(3)\n",
    "print(\"\\nПо размеру матрицы:\")\n",
    "display(rc_by_mat)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Оптимальные параметры для каждой сферы\n",
    "print(\"=== Оптимальные параметры по сферам ===\\n\")\n",
    "\n",
    "optimal_params = []\n",
    "for sphere_id in metrics_df['sphere_id'].unique():\n",
    "    df_sphere = metrics_df[metrics_df['sphere_id'] == sphere_id]\n",
    "    \n",
    "    # Максимальный RC\n",
    "    best_rc_idx = df_sphere['rc_mean'].idxmax()\n",
    "    best_row = df_sphere.loc[best_rc_idx]\n",
    "    \n",
    "    optimal_params.append({\n",
    "        'sphere_id': sphere_id,\n",
    "        'diameter_mm': best_row['diameter_mm'],\n",
    "        'best_rc': best_row['rc_mean'],\n",
    "        'best_iterations': int(best_row['iterations']),\n",
    "        'best_subsets': int(best_row['subsets']),\n",
    "        'best_matrix': int(best_row['matrix_size']),\n",
    "    })\n",
    "\n",
    "optimal_df = pd.DataFrame(optimal_params)\n",
    "display(optimal_df)"
   ]
